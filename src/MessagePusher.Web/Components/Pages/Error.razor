@page "/Error"
@layout MainLayout
@using System.Diagnostics
@inject NavigationManager Nav

<PageTitle>出错了 · 消息推送服务</PageTitle>

<div class="error-page">
    <MudPaper Class="panel error-card" Elevation="0">
        <div class="error-icon tone-error">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h6" Class="error-title">请求处理出错</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary error-desc">
            系统在处理该请求时发生了异常。你可以重新加载页面，或返回首页继续操作。
        </MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary error-request-id">
                请求 ID：<code>@RequestId</code>
            </MudText>
        }
        <div class="d-flex gap-3 mt-8">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" Href="/">返回首页</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reload">重新加载</MudButton>
        </div>
    </MudPaper>
</div>

<style>
    .error-page {
        display: flex;
        justify-content: center;
        padding: 64px 16px;
    }

    .error-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 520px;
        height: auto;
        padding: 48px 40px;
    }

    .error-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 16px;
        margin-bottom: 16px;
    }

    .error-title {
        font-weight: 600;
    }

    .error-desc {
        margin-top: 6px;
    }

    .error-request-id {
        margin-top: 20px;
        word-break: break-all;
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void Reload() => Nav.Refresh();
}
