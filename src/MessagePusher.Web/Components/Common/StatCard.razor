@* 统一统计卡片：数值 + 标签 + 语义色调图标。样式见 app.css 的 .stat-card / .tone-* *@
<MudPaper Class="stat-card" Elevation="0">
    <div class="stat-card-icon @ToneClass">
        <MudIcon Icon="@Icon" Size="Size.Medium" />
    </div>
    <div class="stat-card-body">
        <MudText Typo="Typo.h4" Class="stat-card-value">@Value</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary stat-card-label">@Label</MudText>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public StatTone Tone { get; set; } = StatTone.Primary;

    private string ToneClass => Tone switch
    {
        StatTone.Info => "tone-info",
        StatTone.Success => "tone-success",
        StatTone.Warning => "tone-warning",
        _ => "tone-primary"
    };
}
