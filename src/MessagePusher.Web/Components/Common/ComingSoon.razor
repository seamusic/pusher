@* 统一占位组件：用于尚未实现的功能页，保持全局视觉一致 *@
<MudPaper Class="@RootClass" Elevation="0">
    <div class="coming-soon-icon">
        <MudIcon Icon="@Icon" Size="Size.Large" />
    </div>
    <MudText Typo="Typo.h6" Class="coming-soon-title">@Title</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary coming-soon-desc">
        @Description
    </MudText>
    @if (Features is { Count: > 0 })
    {
        <MudChipSet T="string" Size="Size.Small" Variant="Variant.Text" Class="coming-soon-chips">
            @foreach (var feature in Features)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="coming-soon-chip">@feature</MudChip>
            }
        </MudChipSet>
    }
    <span class="coming-soon-tag">开发中</span>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Icon { get; set; } = Icons.Material.Filled.Construction;
    [Parameter] public IReadOnlyList<string>? Features { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "coming-soon" : $"coming-soon {Class}";
}
